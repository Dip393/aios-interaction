{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIOS Runtime",
  "version": "0.2.0",
  "identifier": "in.aios.runtime",

  "build": {
    "beforeDevCommand": "npm --prefix apps/web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix apps/web run build",
    "frontendDist": "../apps/web/out"
  },

  "app": {
    "windows": [
      {
        "title": "AIOS Runtime",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png"
    ]
  }
}